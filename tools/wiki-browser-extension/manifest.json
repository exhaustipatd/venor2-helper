{
  "manifest_version": 3,
  "name": "Venor Wiki Export",
  "version": "1.2.0",
  "description": "Export shops and pets from your current wiki tab for offline import.",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "action": { "default_title": "Open Venor wiki exporter" },
  "background": { "service_worker": "background.js" }
}
